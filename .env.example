# URL exibida em Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Use uma Publishable key (recomendado) ou a chave anon legada.
# Esta chave é pública e a segurança é garantida pelas políticas RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
# VITE_SUPABASE_ANON_KEY=eyJ...

# Segredos usados somente pelo backend. Nunca use o prefixo VITE_ nestas variáveis.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY
MERCADO_PAGO_ACCESS_TOKEN=TEST-COLE_O_ACCESS_TOKEN_DE_TESTE
MERCADO_PAGO_WEBHOOK_SECRET=COLE_A_ASSINATURA_SECRETA_DO_WEBHOOK

# Endereço público do site. Em desenvolvimento local, use http://localhost:3000.
SITE_URL=http://localhost:3000

# Cotação de frete. Use o token do sandbox enquanto estiver testando.
MELHOR_ENVIO_TOKEN=COLE_O_TOKEN_DO_MELHOR_ENVIO
MELHOR_ENVIO_FROM_POSTAL_CODE=COLE_O_CEP_DE_ORIGEM_SEM_TRACO
MELHOR_ENVIO_USER_AGENT=DROP Skate Shop (seu-email@dominio.com)
MELHOR_ENVIO_SANDBOX=true
